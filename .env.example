# Co-Cre 環境変数のテンプレート
# このファイルを `.env.local` にコピーして値を入れる（.env.local は .gitignore 済み）

# ---- Supabase（M2: 認証・DB・ストレージ） ----
# Supabase Dashboard → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側だけで使う（有料コンテンツ判定・Webhookなど）。絶対にクライアントへ露出させない
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini（AIでしらべる / AIに質問）----
# Google AI Studio (https://aistudio.google.com/) で発行する "AIza…" 形式のキー。
# 未設定 or 形式違いのときは自動でモック動作にフォールバックする。
GEMINI_API_KEY=

# ---- Stripe（M4: VIPサブスク＋買い切り課金） ----
# STRIPE_SECRET_KEY:        sk_test_… / sk_live_…（sk_ で始まる時だけ有効）
# STRIPE_PRICE_ID:          VIP（サブスク）の price_…（recurring 価格）
# STRIPE_LIFETIME_PRICE_ID: 買い切り（lifetime）の price_…（one-time 価格）
# STRIPE_WEBHOOK_SECRET:    whsec_…（Webhook署名検証用）
# いずれか欠けると /vip の該当ボタンはデモ動作にフォールバックする。
# ※Webhookで課金状態を Supabase(subscriptions/purchases) に書くには SUPABASE_SERVICE_ROLE_KEY も必要。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
